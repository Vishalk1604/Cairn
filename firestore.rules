rules_version = '2';

// Everything Cairn stores lives under the signed-in user's own document, so
// one rule decides access and there is no path where a document's owner is
// ambiguous. Anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // A document must name the user it is filed under, so a stray write
    // cannot leave data that reads as someone else's.
    function ownedBy(userId) {
      return request.resource.data.userId == userId;
    }

    function wellFormed(docId) {
      return request.resource.data.id == docId
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number
        && (!('deletedAt' in request.resource.data) || request.resource.data.deletedAt is number);
    }

    match /users/{userId}/notes/{noteId} {
      allow read, delete: if signedInAs(userId);
      allow create, update: if signedInAs(userId)
        && ownedBy(userId)
        && wellFormed(noteId)
        && request.resource.data.title is string
        && request.resource.data.pinned is bool
        && request.resource.data.tags is list
        && (!('body' in request.resource.data) || request.resource.data.body is string)
        // Descriptions of images and recordings. The files themselves live in
        // Drive, so what lands here must stay a small list, not a payload.
        && (!('attachments' in request.resource.data) || request.resource.data.attachments is list);
    }

    match /users/{userId}/reminders/{reminderId} {
      allow read, delete: if signedInAs(userId);
      allow create, update: if signedInAs(userId)
        && ownedBy(userId)
        && wellFormed(reminderId)
        && request.resource.data.title is string
        && request.resource.data.dueAt is number
        && request.resource.data.allDay is bool
        && request.resource.data.status in ['pending', 'snoozed', 'done']
        && request.resource.data.priority in ['low', 'normal', 'high']
        && (!('body' in request.resource.data) || request.resource.data.body is string);
    }

    // Which folders are pinned, their order, the chosen theme. Small, personal
    // and replaceable: shape is the app's business, ownership still is not.
    match /users/{userId}/preferences/{prefId} {
      allow read, write: if signedInAs(userId);
    }

    // Per-device registration for push, and the denormalised payload both
    // widgets read. Shape is the app's business; ownership still is not.
    match /users/{userId}/devices/{deviceId} {
      allow read, write: if signedInAs(userId);
    }

    match /users/{userId}/summary/{summaryId} {
      allow read, write: if signedInAs(userId);
    }
  }
}
