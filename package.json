{
  "name": "cairn",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev:desktop": "pnpm --filter @cairn/desktop dev",
    "dev:mobile": "pnpm --filter @cairn/mobile start",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "typescript": "~6.0.3"
  }
}
