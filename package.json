{
  "name": "cairn",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev:desktop": "pnpm --filter @cairn/desktop dev",
    "dev:mobile": "pnpm --filter @cairn/mobile start",
    "test": "turbo run test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-cairn \"vitest run --config vitest.rules.config.ts\"",
    "typecheck": "turbo run typecheck",
    "invite": "node scripts/invite.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.0.0",
    "firebase-tools": "^15.34.0",
    "turbo": "^2.10.12",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
