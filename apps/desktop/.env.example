# Where Cairn's Worker lives, as `wrangler deploy` printed it (see
# apps/worker/README.md). Leave it empty to use the address written in
# packages/sync/src/worker.ts.
#
# Copy this file to .env.local to set it. It is not a secret: the desktop
# app holds no Google client secret any more, and no Google refresh token —
# the Worker keeps those.
VITE_CAIRN_WORKER_URL=
